{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Assistant",
  "version": "0.1.0",
  "identifier": "com.desktop-assistant.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Desktop Assistant",
        "width": 800,
        "height": 60,
        "minWidth": 300,
        "minHeight": 60,
        "maxWidth": 1200,
        "maxHeight": 1000,
        "x": 100,
        "y": -1,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "decorations": false,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
